# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=civicconnect_super_secret_key_2025

# AI Integration
# Server-side Groq AI key for complaint classification & duplicate detection
GROQ_API_KEY=your_groq_api_key_here

# Storage Configuration
# Local development: defaults to ./uploads
UPLOAD_DIR=./uploads
# Vercel Production: Vercel Blob read/write token (auto-provided if Vercel Blob store is attached)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Database Configuration
# Local development: leave unset to use local civicconnect.db (SQLite)
# Vercel Production: Turso Cloud SQLite connection URL and auth token
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here
